<view class="page">
  <view class="stats">
    <view class="stat">
      <view class="stat-num">{{count}}</view>
      <view class="stat-label">已学单词</view>
    </view>
    <view class="stat">
      <view class="stat-num">3153</view>
      <view class="stat-label">词库总量</view>
    </view>
  </view>

  <view class="section-title">发音</view>
  <view class="segment">
    <view wx:for="{{modeLabels}}" wx:key="*this" class="segment-item {{modeIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="setMode">{{item}}</view>
  </view>
  <view class="hint">切换后会自动试读 hello，发音使用在线真人录音。</view>

  <view class="section-title">学习进度</view>
  <view class="panel">
    <button class="btn btn-ghost btn-block" bindtap="exportProgress">导出进度（复制到剪贴板）</button>
    <button class="btn btn-ghost btn-block" style="margin-top:16rpx" bindtap="importProgress">从剪贴板导入进度</button>
    <button class="btn btn-danger btn-block" style="margin-top:16rpx" bindtap="clear">清除全部记录</button>
    <view class="hint">进度保存在本设备微信中。换设备时请先导出备份，再在新设备导入。</view>
  </view>
</view>
