<view class="page">
  <view class="header-title">超频语境</view>
  <view class="header-sub">3153 分级词汇 · 微信小程序</view>

  <view class="stats">
    <view class="stat">
      <view class="stat-num">{{totalLearned}}</view>
      <view class="stat-label">已学 / {{total}}</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{totalMastered}}</view>
      <view class="stat-label">已掌握</view>
    </view>
  </view>

  <view class="section-title">选择等级</view>
  <view class="level-grid">
    <view wx:for="{{levels}}" wx:key="name" class="level-card {{item.name === selectedLevel ? 'selected' : ''}}" data-level="{{item.name}}" bindtap="selectLevel">
      <view class="level-stars">{{item.name}}</view>
      <view class="level-name">{{item.learned}}/{{item.count}}</view>
      <view class="level-count">已学</view>
      <view class="progress-track"><view class="progress-fill" style="width:{{item.pct}}%"></view></view>
    </view>
  </view>

  <view class="panel">
    <view class="row">
      <text class="row-label">本轮学习词数</text>
      <text class="row-value">{{count}}</text>
    </view>
    <slider min="5" max="100" step="5" value="{{count}}" bindchanging="onCountChange" bindchange="onCountChange" activeColor="#6c63ff" backgroundColor="#252540" block-color="#6c63ff" />
    <button class="btn btn-primary btn-block" style="margin-top:28rpx" bindtap="startStudy">开始学习</button>
  </view>

  <view class="entry-grid">
    <view class="entry" bindtap="goCards">
      <view class="entry-icon">🃏</view>
      <view class="entry-label">卡片浏览</view>
    </view>
    <view class="entry" bindtap="goReview">
      <view class="entry-icon">🔁</view>
      <view class="entry-label">复习</view>
    </view>
    <view class="entry" bindtap="goSettings">
      <view class="entry-icon">⚙️</view>
      <view class="entry-label">设置</view>
    </view>
  </view>
</view>
